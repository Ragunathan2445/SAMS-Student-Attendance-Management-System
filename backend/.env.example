# ---- Databases (local) ------------------------------------------------------
DATABASE_URL=postgresql+psycopg://sams_user:sams_password@localhost:5432/sams_db
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=sams_logs

# ---- Secrets (generate your own; never commit real values) ------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# ---- HTTP --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false

# ---- Parent OTP --------------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3
PARENT_SESSION_MINUTES=60
# DEMO ONLY: lets the OTP screen show the simulated SMS/e-mail. Disable for any real deployment.
ENABLE_DEMO_OTP_INBOX=true

# ---- Teacher sessions (school local time, 24h HH:MM) --------------------------
SCHOOL_TIMEZONE=Asia/Kolkata
SCHOOL_OPEN_TIME=08:00
LUNCH_BREAK_START=12:30
LUNCH_BREAK_END=13:15
SCHOOL_CLOSING_TIME=16:30
# Allow a short "extended demo" session outside school hours (evening demos)
ALLOW_OFF_HOURS_TEACHER_LOGIN=true
OFF_HOURS_SESSION_MINUTES=60

LOGIN_RATE_LIMIT_PER_MINUTE=10
